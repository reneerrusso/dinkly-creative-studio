{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinkly.local/schemas/social_post.schema.json",
  "title": "DINKLY Social Post",
  "description": "A measured social post and its observed creative traits. Unknown fields must be null, not guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "platform",
    "post_date",
    "views",
    "shares",
    "likes",
    "comments",
    "saves",
    "follows_generated",
    "watch_time",
    "completion_rate",
    "format",
    "storyline",
    "left_panel_summary",
    "right_panel_summary",
    "caption",
    "text_on_image",
    "background_color",
    "accent_color",
    "camera_angle",
    "character_count",
    "props",
    "emotional_theme",
    "brand_integration",
    "uploaded_asset_reference",
    "notes"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "platform": {"type": ["string", "null"]},
    "post_date": {"type": ["string", "null"], "format": "date"},
    "views": {"type": ["integer", "null"], "minimum": 0},
    "shares": {"type": ["integer", "null"], "minimum": 0},
    "likes": {"type": ["integer", "null"], "minimum": 0},
    "comments": {"type": ["integer", "null"], "minimum": 0},
    "saves": {"type": ["integer", "null"], "minimum": 0},
    "follows_generated": {"type": ["integer", "null"], "minimum": 0},
    "watch_time": {"type": ["number", "null"], "minimum": 0, "description": "Average watch time in seconds when supplied."},
    "completion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "format": {"type": ["string", "null"]},
    "storyline": {"type": ["string", "null"]},
    "left_panel_summary": {"type": ["string", "null"]},
    "right_panel_summary": {"type": ["string", "null"]},
    "caption": {"type": ["string", "null"]},
    "text_on_image": {
      "type": ["array", "null"],
      "items": {"type": "string"}
    },
    "background_color": {"type": ["string", "null"]},
    "accent_color": {"type": ["string", "null"]},
    "camera_angle": {"type": ["string", "null"]},
    "character_count": {"type": ["integer", "null"], "minimum": 0},
    "props": {
      "type": ["array", "null"],
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "emotional_theme": {"type": ["string", "null"]},
    "brand_integration": {"type": ["string", "null"]},
    "uploaded_asset_reference": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
