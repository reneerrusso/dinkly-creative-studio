{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinkly.local/schemas/storyline_score.schema.json",
  "title": "DINKLY Directional Storyline Score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score_id",
    "storyline_id",
    "title_pair",
    "format",
    "left_scene",
    "right_scene",
    "emotional_insight",
    "why_someone_would_share",
    "relevant_social_learnings",
    "brand_placement_opportunities",
    "execution_risks",
    "recommended_background_color",
    "recommended_accent_color",
    "recommended_camera_angle",
    "props",
    "character_count",
    "novel_angle",
    "scores",
    "directional_total",
    "weakest_criterion",
    "improvement_recommendation",
    "evaluation_label",
    "created_at"
  ],
  "properties": {
    "score_id": {"type": "string", "minLength": 1},
    "storyline_id": {"type": "string", "minLength": 1},
    "title_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {"left": {"type": "string"}, "right": {"type": "string"}}
    },
    "format": {"type": "string"},
    "left_scene": {"type": "string"},
    "right_scene": {"type": "string"},
    "emotional_insight": {"type": "string"},
    "why_someone_would_share": {"type": "string"},
    "relevant_social_learnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "brand_placement_opportunities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "execution_risks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "recommended_background_color": {"type": "string"},
    "recommended_accent_color": {"type": "string"},
    "recommended_camera_angle": {"type": "string"},
    "props": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "character_count": {"type": "integer", "minimum": 1},
    "novel_angle": {"type": "string"},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotional_clarity",
        "relatability",
        "visual_simplicity",
        "scroll_stopping_potential",
        "shareability",
        "save_potential",
        "comment_potential",
        "dinkly_brand_fit",
        "originality",
        "brand_integration_potential",
        "nano_banana_execution_ease",
        "risk_of_character_distortion"
      ],
      "properties": {
        "emotional_clarity": {"type": "integer", "minimum": 1, "maximum": 10},
        "relatability": {"type": "integer", "minimum": 1, "maximum": 10},
        "visual_simplicity": {"type": "integer", "minimum": 1, "maximum": 10},
        "scroll_stopping_potential": {"type": "integer", "minimum": 1, "maximum": 10},
        "shareability": {"type": "integer", "minimum": 1, "maximum": 10},
        "save_potential": {"type": "integer", "minimum": 1, "maximum": 10},
        "comment_potential": {"type": "integer", "minimum": 1, "maximum": 10},
        "dinkly_brand_fit": {"type": "integer", "minimum": 1, "maximum": 10},
        "originality": {"type": "integer", "minimum": 1, "maximum": 10},
        "brand_integration_potential": {"type": "integer", "minimum": 1, "maximum": 10},
        "nano_banana_execution_ease": {"type": "integer", "minimum": 1, "maximum": 10},
        "risk_of_character_distortion": {"type": "integer", "minimum": 1, "maximum": 10, "description": "1 is low risk; 10 is high risk. The total uses the inverse."}
      }
    },
    "directional_total": {"type": "number", "minimum": 1, "maximum": 10},
    "weakest_criterion": {"type": "string"},
    "improvement_recommendation": {"type": "string"},
    "evaluation_label": {"type": "string", "const": "directional creative evaluation, not a performance prediction"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
