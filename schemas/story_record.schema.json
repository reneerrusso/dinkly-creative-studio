{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinkly.local/schemas/story_record.schema.json",
  "title": "DINKLY Scene-Rich Story Record v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "title_left", "title_right", "format", "category", "left_character",
    "left_character_action", "left_setting", "left_props", "left_emotion",
    "right_characters", "right_character_actions", "right_setting", "right_props",
    "right_emotion", "shared_environment", "environmental_contrast", "background_color",
    "accent_color", "camera_angle", "prop_count", "brand_friendly", "brand_categories",
    "execution_risks", "notes", "status", "migration_version"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title_left": {"type": "string", "minLength": 1},
    "title_right": {"type": "string", "minLength": 1},
    "format": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "left_character": {"enum": ["boy", "girl"]},
    "left_character_action": {"type": "string"},
    "left_setting": {"type": "string"},
    "left_props": {"type": "array", "items": {"type": "string"}},
    "left_emotion": {"type": "string"},
    "right_characters": {"const": "boy_and_girl"},
    "right_character_actions": {"type": "string"},
    "right_setting": {"type": "string"},
    "right_props": {"type": "array", "items": {"type": "string"}},
    "right_emotion": {"type": "string"},
    "shared_environment": {"type": "string"},
    "environmental_contrast": {"type": "string"},
    "background_color": {"type": "string"},
    "accent_color": {"type": "string"},
    "camera_angle": {"type": "string"},
    "prop_count": {"type": "integer", "minimum": 0},
    "brand_friendly": {"type": "boolean"},
    "brand_categories": {"type": "array", "items": {"type": "string"}},
    "execution_risks": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "migration_version": {"const": 2}
  }
}
