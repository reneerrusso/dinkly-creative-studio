{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinkly.local/schemas/competitor_post.schema.json",
  "title": "Public Competitor Post",
  "type": "object",
  "required": ["id", "handle_id", "platform", "platform_post_id", "hashtags", "creative_attributes", "first_seen_at", "last_seen_at", "provider", "raw_metadata"],
  "properties": {
    "id": {"type": "string"},
    "handle_id": {"type": "string"},
    "platform": {"enum": ["instagram", "tiktok"]},
    "platform_post_id": {"type": "string", "minLength": 1},
    "post_url": {"type": ["string", "null"]},
    "caption": {"type": ["string", "null"]},
    "hashtags": {"type": "array", "items": {"type": "string"}},
    "posted_at": {"type": ["string", "null"]},
    "media_type": {"type": ["string", "null"]},
    "thumbnail_path": {"type": ["string", "null"]},
    "remote_thumbnail_url": {"type": ["string", "null"]},
    "media_url": {"type": ["string", "null"]},
    "carousel_item_count": {"type": ["integer", "null"], "minimum": 0},
    "duration_seconds": {"type": ["number", "null"], "minimum": 0},
    "view_count": {"type": ["integer", "null"], "minimum": 0},
    "like_count": {"type": ["integer", "null"], "minimum": 0},
    "comment_count": {"type": ["integer", "null"], "minimum": 0},
    "share_count": {"type": ["integer", "null"], "minimum": 0},
    "audio_name": {"type": ["string", "null"]},
    "creative_attributes": {"type": "object"},
    "first_seen_at": {"type": "string"},
    "last_seen_at": {"type": "string"},
    "provider": {"type": "string"},
    "raw_metadata": {"type": "object"}
  },
  "additionalProperties": false
}
